# ==============================================================================
# NEHU Issue Reporting & Feedback — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values:
# cp .env.example .env

# 1. Harsh's Go Backend API Base URL
EXPO_PUBLIC_API_URL=https://api.nehu.ac.in/issues/v1

# 2. Soumojit's FastAPI Microservice URL (Chatbot AI Service)
EXPO_PUBLIC_FASTAPI_AI_URL=http://10.0.2.2:8000

# 3. Google Gemini API Key (Direct Free Cloud LLM for Grievance Assistant)
# Get a free key at: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
